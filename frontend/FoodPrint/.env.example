# Copy to .env and fill in real values (.env is already in .gitignore and will not be committed)
# Expo injects EXPO_PUBLIC_ variables into the client at build time; unprefixed variables are available only in Node

# Supabase (required for login, registration, and backend API JWT authentication)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Spring Boot backend API base URL. For physical devices and emulators, use the computer LAN IP, e.g. http://192.168.1.x:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
